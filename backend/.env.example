# Docker: PostgreSQL (definido no docker-compose.yml). Local sem Docker: SQLite.
DATABASE_URL=sqlite:///./souschef.db
POSTGRES_PASSWORD=troque-esta-senha
# Obrigatória. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# Agente IA (Ollama local). Modelos leves: qwen2.5:1.5b (padrão), llama3.2:1b, gemma3:1b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Voz (faster-whisper): tiny | base | small (padrão; mais preciso em português). beam 1 = mais rápido
WHISPER_MODEL=small
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE=pt

# Login com Google: IDs de cliente OAuth aceitos (web,android,ios), separados por vírgula
GOOGLE_CLIENT_IDS=

# IP (ou nome) do servidor na rede: o certificado HTTPS do Caddy é emitido para ele
SOUSCHEF_HOST=192.168.0.5
# Expo Go (sem a CA do Caddy) acessa o backend por HTTP: 0.0.0.0 libera a porta 8000 na rede
BACKEND_BIND=127.0.0.1
