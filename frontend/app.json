{
  "expo": {
    "name": "SousChef Digital",
    "slug": "souschef-digital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.souschef.digital"
    },
    "android": {
        "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.souschef.digital"
    },
      "ios": {
        "infoPlist": {
          "NSMicrophoneUsageDescription": "Precisamos do microfone para você falar suas solicitações ao assistente de receitas."
        },
        "supportsTablet": true,
        "bundleIdentifier": "com.souschef.digital"
      },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "scheme": "souschef"
  }
}
